# Court Hearing Reminder Portal — Environment Variables Template
# Copy this file to .env and provide your actual values.
# NEVER commit the actual .env file to version control.

# ---- Database ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=courtdb
DB_USERNAME=courtuser
DB_PASSWORD=change_me_strong_password_123

# MySQL root password (internal Docker initialization)
DB_ROOT_PASSWORD=change_me_root_password_456

# ---- JWT Secret ----
# Must be at least 32 characters (256 bits)
JWT_SECRET=change_me_to_a_very_long_random_secret_key_at_least_256_bits_long

# ---- Docker ----
DOCKER_HUB_USERNAME=local
IMAGE_TAG=1.0.0

