# Environment Variables — Copy this to .env and fill in real values
# NEVER commit the actual .env file (it is in .gitignore)

# ---- Database ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=courtdb
DB_USERNAME=courtuser
DB_PASSWORD=change_me_strong_password_123

# MySQL root password (Docker Compose internal use)
DB_ROOT_PASSWORD=change_me_root_password_456

# ---- JWT Secret ----
# Must be ≥ 32 characters (256 bits) for HS256 security
JWT_SECRET=change_me_to_a_very_long_random_secret_key_at_least_256_bits_long

# ---- Docker Hub ----
DOCKER_HUB_USERNAME=your_dockerhub_username
IMAGE_TAG=1.0.0
